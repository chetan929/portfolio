{
    "buildCommand": "pip install -r requirements.txt",
    "framework": "django",
    "python": {
        "version": "3.11"
    },
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.py"
        }
    ]
}